def move_three_today(data, limit=3):
    """Spread up to `limit` unreviewed new problems across the next days."""
    today = datetime.now().date()
    today_str = today.strftime("%Y-%m-%d")
    candidates = get_move_three_today_candidates(data, today_str)[:limit]
    moved = []

    for day_offset, problem in enumerate(candidates, start=1):
        target_date = (today + timedelta(days=day_offset)).strftime("%Y-%m-%d")
        problem["next_review"] = target_date
        moved.append((problem, target_date))

    if moved:
        save_data(data)

    return moved


def print_move_three_today_result(moved):
