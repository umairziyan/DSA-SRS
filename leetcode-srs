def review_problem_interactively(problem, review_date, allow_session_actions=False):
    """Review a single problem and apply the FSRS update."""
    while True:
        print(f"  How did it go?")
        print(f"    {Colors.MAGENTA}1{Colors.RESET} - Again (forgot/couldn't solve)")
        print(f"    {Colors.RED}2{Colors.RESET} - Hard (struggled significantly)")
        print(f"    {Colors.YELLOW}3{Colors.RESET} - Good (some effort)")
        print(f"    {Colors.GREEN}4{Colors.RESET} - Easy (knew it quickly)")
        print(f"    {Colors.DIM}v{Colors.RESET} - View note")
        print(f"    {Colors.DIM}s{Colors.RESET} - Skip for now")
        if allow_session_actions:
            print(f"    {Colors.DIM}q{Colors.RESET} - Quit and save progress")
            print(f"    {Colors.DIM}c{Colors.RESET} - Cancel session (discard all progress)")

        choice = input(f"\n  Your choice: ").strip().lower()

        if allow_session_actions and choice == 'q':
            return "quit"
        elif allow_session_actions and choice == 'c':
            confirm = input(
                f"\n  {Colors.YELLOW}Cancel and discard all progress from this session? (y/N): {Colors.RESET}"
            ).strip().lower()
            if confirm == 'y':
                return "cancel"
            print()
            continue
        elif choice == 's':
            print(f"{Colors.DIM}Skipped.{Colors.RESET}\n")
            return "skipped"
        elif choice == 'v':
            note = problem.get("note", "").strip()
            if note:
                print(f"\n  {Colors.DIM}Note:{Colors.RESET} {note}\n")
            else:
                print(f"\n  {Colors.DIM}No note yet for this problem.{Colors.RESET}\n")
            continue
        elif choice in ['1', '2', '3', '4']:
            rating = int(choice)

            while True:
                new_s, new_d, new_interval, new_state, retrievability = process_review(
                    problem, rating, review_date
                )

                if rating != RATING_HARD or new_interval <= HARD_LONG_INTERVAL_WARNING:
                    break

                print(
                    f"\n  {Colors.YELLOW}Warning:{Colors.RESET} Hard rating will schedule next review "
                    f"in {Colors.CYAN}{new_interval} days{Colors.RESET}."
                )
                print(
                    f"  This is because your memory stability is already high "
                    f"({problem.get('stability', 0):.1f}d)."
                )
                print(
                    f"  If you actually forgot/couldn't solve it, use "
                    f"{Colors.MAGENTA}Again (1){Colors.RESET} instead."
                )
                confirm = input(
                    f"\n  {Colors.YELLOW}(c){Colors.RESET}onfirm Hard, switch to "
                    f"{Colors.MAGENTA}(1){Colors.RESET} Again, or {Colors.DIM}(n){Colors.RESET} cancel: "
                ).strip().lower()
                if confirm == '1':
                    rating = RATING_AGAIN
                    continue
                if confirm == 'c':
                    break

                print(f"  {Colors.DIM}Cancelled. Please re-enter your rating.{Colors.RESET}\n")
                rating = None
                break

            if rating is None:
                continue

            review_day = datetime.strptime(review_date, "%Y-%m-%d")
            next_date = (review_day + timedelta(days=new_interval)).strftime("%Y-%m-%d")

            # Update problem with FSRS fields.
            problem["stability"] = new_s
            problem["difficulty"] = new_d
            problem["state"] = new_state
            problem["next_review"] = next_date
            problem["last_review_date"] = review_date
            problem["review_count"] += 1
            problem["last_rating"] = rating
            problem["reps"] = problem.get("reps", 0) + 1 if rating > RATING_AGAIN else 0
            problem["history"].append({
                "date": review_date,
                "rating": rating,
                "stability": new_s,
                "difficulty": new_d,
                "interval": new_interval,
                "retrievability": retrievability
            })
            note_action = prompt_for_note(problem)
            print_note_result(note_action)

            if rating == RATING_AGAIN:
                print(
                    f"\n  {Colors.MAGENTA}Again!{Colors.RESET} Stability: "
                    f"{Colors.CYAN}{new_s:.1f}d{Colors.RESET} | Next: {next_date}"
                )
            else:
                print(
                    f"\n  {Colors.GREEN}Recorded!{Colors.RESET} Next review in "
                    f"{Colors.CYAN}{new_interval} days{Colors.RESET} (S:{new_s:.1f}d)"
                )
            print()
            return "reviewed"

        else:
            valid_choices = "1, 2, 3, 4, v, s, q, or c" if allow_session_actions else "1, 2, 3, 4, v, or s"
            print(f"  {Colors.RED}Invalid choice. Enter {valid_choices}.{Colors.RESET}\n")


def cmd_add(args):
    """Add a new problem to track."""
    if not args:
        print(f"{Colors.RED}Usage: leetcode-srs add <problem-name> [url] [company]{Colors.RESET}")
        return

    name = args[0]
    url = args[1] if len(args) > 1 else ""
    company_tag = args[2] if len(args) > 2 else None

    problem_num = extract_problem_number(name)
    if problem_num is None:
        print(f"{Colors.RED}Error: Problem name must start with a number and dot (e.g., '171. Problem Name'){Colors.RESET}")
        return

    data = load_data()

    for existing in data["problems"]:
        existing_num = extract_problem_number(existing["name"])
        if existing_num == problem_num:
            interval = calculate_interval(existing.get("stability", 0))
            review_count = existing.get("review_count", 0)
            print(f"{Colors.RED}Duplicate found:{Colors.RESET} '{existing['name']}' (interval: {interval}d, {review_count} reviews)")
            tag_input = input(f"  Tag with company and reset? Enter company name (or Enter to skip): ").strip()
            if tag_input:
                tag = normalize_tag(tag_input, data)
                tags = existing.setdefault("tags", [])
                if tag not in tags:
                    tags.append(tag)
                reset_problem_schedule(existing)
                save_data(data)
                print(f"  Tagged as {format_tags([tag])} and reset. First review: {Colors.YELLOW}Tomorrow{Colors.RESET}")
            else:
                print(f"  Next review: {format_date(existing['next_review'])}")
                print(f"  Reviews: {existing['review_count']}")
            return

    today = datetime.now()

    # New problems always review tomorrow for optimal FSRS learning
    next_review = (datetime.now() + timedelta(days=1)).strftime("%Y-%m-%d")
    days_ahead = 1

    problem = {
        "id": str(uuid.uuid4())[:8],
        "name": name,
        "url": url,
        "added_date": today.strftime("%Y-%m-%d"),
        "stability": 0,
        "difficulty": 5.0,
        "state": "new",
        "last_review_date": None,
        "next_review": next_review,
        "reps": 0,
        "review_count": 0,
        "last_rating": None,
        "history": [],
        "tags": [],
        "fsrs_version": 6,
    }

    if company_tag:
        tag = normalize_tag(company_tag, data)
        problem["tags"] = [tag]
    elif PROMPT_FOR_TAG_ON_ADD:
        tag_input = input(f"  Company tag? {Colors.DIM}(Enter to skip){Colors.RESET}: ").strip()
        if tag_input:
            problem["tags"] = [normalize_tag(tag_input, data)]

    data["problems"].append(problem)
    increment_today_adds(data)
    save_data(data)

    tags_str = format_tags(problem["tags"])
    tags_display = f"  {tags_str}" if tags_str else ""
    print(f"{Colors.GREEN}Added:{Colors.RESET} {name}{tags_display}")
    if days_ahead == 1:
        print(f"  First review: {Colors.YELLOW}Tomorrow{Colors.RESET}")
    else:
        print(f"  First review: {Colors.BLUE}In {days_ahead} days{Colors.RESET} ({next_review})")

    adds_today = get_today_adds(data)
    if adds_today >= MIN_ADDS_PER_DAY:
        print(f"  {Colors.GREEN}Daily goal reached! ({adds_today}/{MIN_ADDS_PER_DAY}){Colors.RESET}")
    else:
        print(f"  {Colors.DIM}Progress: {adds_today}/{MIN_ADDS_PER_DAY} problems added today{Colors.RESET}")


