    if not data["problems"]:
        print(f"{Colors.YELLOW}No problems yet. Add some with 'leetcode-srs add'.{Colors.RESET}")
        return

    # Parse arguments
    count = 1
    include_new = False
    start_review = False

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--include-new":
            include_new = True
        elif arg == "--review":
            start_review = True
        elif arg.isdigit():
            count = int(arg)
        else:
            print(f"{Colors.RED}Unknown argument: {arg}{Colors.RESET}")
            print(f"Usage: leetcode-srs random [count] [--review] [--include-new]")
            return
        i += 1

    # Filter eligible problems
    today = datetime.now().date()
    eligible = []

    for p in data["problems"]:
        # Exclude new problems unless flag set
        if not include_new and p.get('state') == 'new':
            continue
        eligible.append(p)

    if not eligible:
        print(f"{Colors.YELLOW}No eligible problems for random selection.{Colors.RESET}")
        if not include_new:
            print(f"{Colors.DIM}Tip: Use --include-new to include unreviewed problems.{Colors.RESET}")
        return

    # Cap count at available
    count = min(count, len(eligible))

    # Calculate weights for all eligible problems
    weights = []
    retrievabilities = []
    for p in eligible:
        weight, r = calculate_problem_weight(p, today)
        weights.append(weight)
        retrievabilities.append(r)

    # Weighted random selection
    selected_indices = random.choices(range(len(eligible)), weights=weights, k=count)
    selected_problems = [eligible[i] for i in selected_indices]
    selected_retrievabilities = [retrievabilities[i] for i in selected_indices]

    # Display
    if count == 1:
        problem = selected_problems[0]
        r = selected_retrievabilities[0]

        print(f"\n{Colors.BOLD}=== Random Problem Selected ==={Colors.RESET}\n")
        print(f"  {Colors.CYAN}{problem['name']}{Colors.RESET}")
        print(f"  {Colors.DIM}{problem['url']}{Colors.RESET}")
        print()
        print(f"  Selection Reason: {get_selection_reason(problem, today, r)}")
        print()

        # Prompt for review if not auto-starting
        if not start_review:
            response = input("Would you like to review this now? (y/N): ").strip().lower()
            if response == 'y':
                start_review = True

        # Review the selected problem
        if start_review:
            today_str = datetime.now().strftime("%Y-%m-%d")

            # Show problem info
            stability = problem.get("stability", 0)
            print(f"{Colors.BOLD}Reviewing: {problem['name']}{Colors.RESET}")
            print(f"  Review #{problem['review_count'] + 1} | S:{stability:.1f}d | R:{r*100:.0f}%")
            print()

            action = review_problem_interactively(problem, today_str)
            if action == "reviewed":
                save_data(data)
    else:
        print(f"\n{Colors.BOLD}=== {count} Random Problems Selected ==={Colors.RESET}\n")
        for i, (problem, r) in enumerate(zip(selected_problems, selected_retrievabilities), 1):
            reason = get_selection_reason(problem, today, r)
            print(f"{i}. {Colors.CYAN}{problem['name']}{Colors.RESET}")
            print(f"   {Colors.DIM}{problem['url']}{Colors.RESET}")
            print(f"   {reason}")
            print()


def cmd_pull(args):
    """Review a specific tomorrow problem early from today."""
    if not args:
        print(f"{Colors.RED}Usage: leetcode-srs pull <name|id>{Colors.RESET}")
        return

    search = " ".join(args)
    data = load_data()
    matches = find_problem_matches(data, search)

    if not matches:
        print(f"{Colors.RED}No problem found matching '{search}'{Colors.RESET}")
        return

    if len(matches) > 1:
        print(f"{Colors.YELLOW}Multiple matches found:{Colors.RESET}")
        for p in matches:
            print(f"  [{p['id']}] {p['name']}")
        print(f"\nUse the ID to pull a specific problem.")
        return

    problem = matches[0]
    today = datetime.now().date()
    today_str = today.strftime("%Y-%m-%d")
    tomorrow_str = (today + timedelta(days=1)).strftime("%Y-%m-%d")
    next_review = problem["next_review"]

    if next_review <= today_str:
        print(
            f"{Colors.YELLOW}'{problem['name']}' is already due {format_date(next_review)}.{Colors.RESET}"
        )
        print(f"Use {Colors.CYAN}leetcode-srs review{Colors.RESET} or {Colors.CYAN}leetcode-srs today{Colors.RESET} instead.")
        return

    if next_review != tomorrow_str:
        print(
            f"{Colors.YELLOW}'{problem['name']}' is scheduled for {format_date(next_review)} "
            f"({next_review}).{Colors.RESET}"
        )
        print(f"This command only pulls problems from tomorrow into today.")
        return

    tomorrow_count_before = get_due_count_by_date(data, tomorrow_str)

    stability = problem.get("stability", 0)
    last_review = problem.get("last_review_date")
    if last_review and stability > 0:
        last_date = datetime.strptime(last_review, "%Y-%m-%d")
        elapsed = (datetime.now() - last_date).days
        r = calculate_retrievability(elapsed, stability)
        r_display = f"R:{r*100:.0f}%"
    else:
        r_display = "New"

    tags_str = format_tags(problem.get("tags", []))
    tags_display = f"  {tags_str}" if tags_str else ""
    print(f"\n{Colors.BOLD}=== Pull From Tomorrow ==={Colors.RESET}\n")
    print(f"  {Colors.CYAN}{problem['name']}{Colors.RESET}{tags_display}")
    if problem["url"]:
        print(f"  {Colors.DIM}{problem['url']}{Colors.RESET}")
    print(
        f"  Reviewing early from tomorrow | Review #{problem['review_count'] + 1} | "
        f"S:{stability:.1f}d | {r_display} | Last: {format_last_review(last_review)}"
    )
    print()

    action = review_problem_interactively(problem, today_str)
    if action != "reviewed":
        return

    save_data(data)

    tomorrow_count_after = get_due_count_by_date(data, tomorrow_str)
    if tomorrow_count_after == tomorrow_count_before:
        print(
            f"  {Colors.DIM}Tomorrow queue unchanged at {tomorrow_count_after}. "
            f"This can happen after an Again rating.{Colors.RESET}"
        )
    else:
        print(
            f"  {Colors.CYAN}Tomorrow queue:{Colors.RESET} "
            f"{tomorrow_count_before} -> {tomorrow_count_after}"
        )


def cmd_tag(args):
    """Tag a problem with a company name."""
    if len(args) < 2:
        print(f"{Colors.RED}Usage: leetcode-srs tag <name|id> <company> [--remove]{Colors.RESET}")
        return

    search = args[0].lower()
    company_raw = args[1]
    remove = "--remove" in args

    data = load_data()
    matches = [p for p in data["problems"]
               if search in p["name"].lower() or search == p["id"]]

    if not matches:
        print(f"{Colors.RED}No problem found matching '{args[0]}'{Colors.RESET}")
        return

    if len(matches) > 1:
        print(f"{Colors.YELLOW}Multiple matches found:{Colors.RESET}")
        for p in matches:
            print(f"  [{p['id']}] {p['name']}")
        print(f"\nUse the ID to tag a specific problem.")
        return

    problem = matches[0]
    tag = normalize_tag(company_raw, data)
    tags = problem.setdefault("tags", [])

    if remove:
        if tag in tags:
            tags.remove(tag)
            save_data(data)
            print(f"Removed {format_tags([tag])} from '{problem['name']}'")
        else:
            print(f"{Colors.YELLOW}Tag '{tag}' not found on '{problem['name']}'{Colors.RESET}")
    else:
        if tag not in tags:
            tags.append(tag)
            save_data(data)
        print(f"Tagged '{problem['name']}' as {format_tags([tag])}")


def cmd_reset(args):
    """Reset a problem's schedule to start fresh."""
    if not args:
        print(f"{Colors.RED}Usage: leetcode-srs reset <name|id>{Colors.RESET}")
        return

    search = args[0].lower()
    data = load_data()
    matches = [p for p in data["problems"]
               if search in p["name"].lower() or search == p["id"]]

    if not matches:
        print(f"{Colors.RED}No problem found matching '{args[0]}'{Colors.RESET}")
        return

    if len(matches) > 1:
        print(f"{Colors.YELLOW}Multiple matches found:{Colors.RESET}")
        for p in matches:
            print(f"  [{p['id']}] {p['name']}")
        print(f"\nUse the ID to reset a specific problem.")
        return

    problem = matches[0]
    interval = calculate_interval(problem.get("stability", 0))
    review_count = problem.get("review_count", 0)
    tags_str = format_tags(problem.get("tags", []))
    tags_display = f"  {tags_str}" if tags_str else ""
    print(f"'{problem['name']}'{tags_display} (interval: {interval}d, {review_count} reviews)")
    confirm = input(f"Reset? (y/N): ").strip().lower()

    if confirm == 'y':
        reset_problem_schedule(problem)
        save_data(data)
        print(f"{Colors.GREEN}Reset '{problem['name']}'. First review: {Colors.YELLOW}Tomorrow{Colors.RESET}")
    else:
        print(f"{Colors.DIM}Cancelled.{Colors.RESET}")


