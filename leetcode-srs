        "tag": cmd_tag,
        "reset": cmd_reset,
        "random": cmd_random,
        "sync": cmd_sync,
        "help": cmd_help,
    }

    if len(sys.argv) < 2:
        cmd_today([])
        return

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    if cmd in commands:
        commands[cmd](args)
    else:
        print(f"{Colors.RED}Unknown command: {cmd}{Colors.RESET}")
        print(f"Use 'leetcode-srs help' for available commands.")


